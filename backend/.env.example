# Copy this file to .env in the backend/ folder to enable real AI-generated insights.
# If OPENAI_API_KEY is left blank or this file doesn't exist, SnapDeck automatically
# falls back to a deterministic, data-grounded insight sentence — the demo always works
# either way.

OPENAI_API_KEY=
# Optional — only set this if you're pointing at a non-default OpenAI-compatible
# endpoint (Azure OpenAI, a self-hosted proxy, OpenRouter, etc). Leave blank to
# use OpenAI's default API URL.
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini
